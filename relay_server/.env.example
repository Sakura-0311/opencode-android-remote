# 生产必设：建房管理令牌（桌面端 auth 消息携带 admin_token）
# v4.7.0 起强制：为空/占位符/短于 16 字符则 relay 拒绝启动
# 生成：openssl rand -hex 24
RELAY_ADMIN_TOKEN=
# relay 在 Nginx/Caddy 反代后时，填反代的出口 IP（逗号分隔）
# v5.0.1 起语义变更：默认**留空 = 不信任任何代理、忽略 X-Forwarded-For**。
# 此前默认值 127.0.0.1,::1 配合「只绑回环」的默认部署，会让本机任意进程
# 自带 XFF 伪造来源 IP（绕过限流 / 反向把他人 jail）。只有真的接了反代
# 才需要填这里的出口 IP，且不要写客户端能直连到的地址。
TRUSTED_PROXIES=
# WebSocket Origin 白名单（逗号分隔），v5.0.1 新增。
# 原生 App 不发 Origin，留空不影响 App；留空时一切带 Origin 的浏览器连接被拒，
# 可防「任意网页直连本机 relay」。
# 例：RELAY_ALLOWED_ORIGINS=https://relay.example.com
RELAY_ALLOWED_ORIGINS=
# 默认关闭；需要接收 App 崩溃上报时设为 1（C3）
RELAY_ENABLE_CRASH_REPORT=0
# 对外端口映射（宿主机:容器），默认 8765
# PORT=8765
# HTTPS（wss）直连：把证书挂进来并取消下面两行的注释
# SSL_CERTFILE=/app/certs/fullchain.pem
# SSL_KEYFILE=/app/certs/privkey.pem
# 监听绑定（D1）：默认只绑宿主机回环；局域网直连时设为 0.0.0.0
# BIND_ADDR=127.0.0.1
