# 生产必设：建房管理令牌（桌面端 auth 消息携带 admin_token）
RELAY_ADMIN_TOKEN=换成你自己的随机字符串
# relay 在 Nginx/Caddy 反代后时，填反代的出口 IP（逗号分隔）
TRUSTED_PROXIES=127.0.0.1,::1
# 默认关闭；需要接收 App 崩溃上报时设为 1（C3）
RELAY_ENABLE_CRASH_REPORT=0
# 对外端口映射（宿主机:容器），默认 8765
# PORT=8765
# HTTPS（wss）直连：把证书挂进来并取消下面两行的注释
# SSL_CERTFILE=/app/certs/fullchain.pem
# SSL_KEYFILE=/app/certs/privkey.pem
