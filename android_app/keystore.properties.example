# 本地 release 签名配置（N-1）
# 复制为 android_app/keystore.properties 后填入真实值；该文件已加入 .gitignore，永不提交。
# CI 环境请改用 Secrets: RELEASE_KEYSTORE_FILE / RELEASE_KEYSTORE_PASSWORD /
# RELEASE_KEY_ALIAS / RELEASE_KEY_PASSWORD。
storeFile=/absolute/path/to/release.keystore
storePassword=
keyAlias=opencode-release
keyPassword=
