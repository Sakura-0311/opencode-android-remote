<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- P0-2: Release 默认仅允许受信任证书的 HTTPS/WSS 流量，禁用一切明文传输。
         本地调试用的明文例外只在 src/debug 的同名配置中出现。 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
